{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUTECUT PRO",
  "version": "2.3.10",
  "identifier": "com.guldastaislamorquran.cutecutpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Quran Video Editor & Audio Aligner",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: referrer; media-src 'self' https: data: blob:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["all"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "copyright": "Copyright © 2026 Quran Video Editor",
    "publisher": "Quran Video Editor Studio",
    "deb": {
      "depends": [],
      "files": {}
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "permissions": [
    "core:default",
    "core:fs:allow-read",
    "core:fs:allow-write",
    "core:fs:allow-exists",
    {
      "identifier": "fs:allow-all",
      "description": "Allows unrestricted reading and writing to the local user filesystems",
      "permissions": [
        {
          "identifier": "core:fs:allow-read",
          "scope": ["$HOME/**", "$DESKTOP/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
        },
        {
          "identifier": "core:fs:allow-write",
          "scope": ["$HOME/**", "$DESKTOP/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
        }
      ]
    }
  ]
}
